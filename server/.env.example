# Database — SQLite for local dev (zero setup), switch to PostgreSQL for production
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/adhd_server

# JWT — change SECRET_KEY before any production use
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Environment: development | production
ENVIRONMENT=development

# Monitoring (synthetic checks + integrity thresholds) — see app/monitoring/
MONITORING_API_KEY=change-me-in-production-use-openssl-rand-hex-32
MONITORING_ACCOUNT_EMAIL=monitor@adhdknight.internal
MONITORING_ACCOUNT_PASSWORD=change-me-in-production
MONITORING_CHECK_INTERVAL_MINUTES=15
MONITORING_ESCALATION_THRESHOLD=2
MONITORING_API_BASE_URL=http://127.0.0.1:8095
MONITORING_WEB_CONSOLE_BASE_URL=http://127.0.0.1:8000
INTEGRITY_USER_COUNT_GROWTH_THRESHOLD=20
INTEGRITY_USER_DATA_GROWTH_THRESHOLD=100
