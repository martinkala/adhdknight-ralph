# Managed by Ansible (deploy/ansible/roles/app) — do not edit by hand, edit the
# vault file and re-run the playbook instead.
DATABASE_URL={{ vault_database_url }}
SECRET_KEY={{ vault_secret_key }}
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
ENVIRONMENT=production

MONITORING_API_KEY={{ vault_monitoring_api_key }}
MONITORING_ACCOUNT_EMAIL={{ vault_monitoring_account_email }}
MONITORING_ACCOUNT_PASSWORD={{ vault_monitoring_account_password }}
MONITORING_CHECK_INTERVAL_MINUTES={{ monitoring_check_interval_minutes | default(15) }}
MONITORING_ESCALATION_THRESHOLD={{ monitoring_escalation_threshold | default(2) }}
MONITORING_API_BASE_URL=http://127.0.0.1:8095
MONITORING_WEB_CONSOLE_BASE_URL=http://127.0.0.1:8000
INTEGRITY_USER_COUNT_GROWTH_THRESHOLD={{ integrity_user_count_growth_threshold | default(20) }}
INTEGRITY_USER_DATA_GROWTH_THRESHOLD={{ integrity_user_data_growth_threshold | default(100) }}
