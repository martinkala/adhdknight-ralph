# Managed by Ansible (deploy/ansible/roles/app) — do not edit by hand, edit the
# vault file and re-run the playbook instead.
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=console.adhdknight.com
DJANGO_SECRET_KEY={{ vault_django_secret_key }}
DJANGO_DATABASE_URL={{ vault_django_database_url }}
# MUST be 127.0.0.1, never a LAN/dev IP — see git history for the incident this
# guards against (adhd-web can't reach a LAN-only address from the server).
FASTAPI_URL=http://127.0.0.1:8095
