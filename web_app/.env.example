# Django settings — local dev works with none of these set (SQLite, DEBUG on).
# Copy to .env and fill in for production.

# Debug — MUST be false in production
DJANGO_DEBUG=true

# Comma-separated list of allowed hosts. Empty for local dev.
# Production: console.adhdknight.com
DJANGO_ALLOWED_HOSTS=

# SECURITY WARNING: generate a real secret for production, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Never commit the real value.
DJANGO_SECRET_KEY=django-insecure-p(dqgutj7@p8nf6q6z@-l6&b7hwvyzzmute5x0%bpre_esap70

# Postgres connection for production (adhd_web database — bound to localhost only, see FR-006).
# Leave unset for local dev (falls back to SQLite db.sqlite3).
# DJANGO_DATABASE_URL=postgresql://adhd_web:password@127.0.0.1:5432/adhd_web

# FastAPI backend URL the console talks to server-side (existing setting, unrelated to this file's new vars).
FASTAPI_URL=http://192.168.77.24:8095
